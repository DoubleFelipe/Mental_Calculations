# =============================
# Mental Calculations — Backend
# =============================
# Copie este arquivo para .env e preencha os valores reais.

# ---- Servidor ----
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- Banco de Dados MySQL 8 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=mental_calculations

# ---- JWT ----
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=seu_jwt_secret_super_seguro_aqui
JWT_EXPIRES_IN=7d

# ---- Google OAuth 2.0 ----
# Crie em: https://console.cloud.google.com/
# Produção: use https://SEU-BACKEND.up.railway.app/api/auth/google/callback
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=seu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ---- Session (para OAuth flow) ----
SESSION_SECRET=seu_session_secret_aqui
